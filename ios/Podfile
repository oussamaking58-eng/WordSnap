# Safe load of Flutter helper scripts
flutter_helper_path = File.join(File.dirname(File.realpath(__FILE__)), 'Flutter', 'generated_helper.rb')
if File.exist?(flutter_helper_path)
  load flutter_helper_path
end

platform :ios, '13.0'

# use_modular_headers! forces CocoaPods to generate Clang module maps for ALL pods.
# This is required for GeneratedPluginRegistrant.m to use @import statements
# without use_frameworks! (which conflicts with Firebase binary pods).
use_modular_headers!

target 'Runner' do
  if respond_to?(:flutter_install_all_ios_pods)
    flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    if respond_to?(:flutter_additional_ios_build_settings)
      flutter_additional_ios_build_settings(target)
    end
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      config.build_settings['ENABLE_BITCODE'] = 'NO'
    end
  end
end
