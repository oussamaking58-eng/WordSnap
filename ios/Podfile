platform :ios, '13.0'

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # On laisse Codemagic gérer l'injection des pods Flutter
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      # Désactiver bitcode car cela cause souvent des erreurs sur les builds cloud
      config.build_settings['ENABLE_BITCODE'] = 'NO'
    end
  end
end
