# Safe load of Flutter helper script
flutter_helper_path = File.join(File.dirname(File.realpath(__FILE__)), 'Flutter', 'generated_helper.rb')
if File.exist?(flutter_helper_path)
  load flutter_helper_path
end

platform :ios, '13.0'

# Crucial: This ensures Swift plugins are packaged as frameworks
use_frameworks!
use_modular_headers!

target 'Runner' do
  # Specific modular header for the problematic plugin
  pod 'audioplayers_darwin', :modular_headers => true

  # Only run if the helper was successfully loaded
  if respond_to?(:flutter_install_all_ios_pods)
    flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    # Only run if the helper was successfully loaded
    if respond_to?(:flutter_additional_ios_build_settings)
      flutter_additional_ios_build_settings(target)
    end
    
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      # Force Modules and Swift compatibility
      config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
      config.build_settings['DEFINES_MODULE'] = 'YES'
      config.build_settings['SWIFT_VERSION'] = '5.0'
      # Fix for module discovery
      config.build_settings['ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES'] = 'YES'
    end
  end
end
